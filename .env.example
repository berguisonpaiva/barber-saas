# ─── Banco (docker compose up -d sobe este Postgres) ───
DATABASE_URL="postgresql://barber:barber@localhost:5432/barber_saas?schema=public"

# ─── Auth.js ─── gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-longo"
AUTH_TRUST_HOST=true

# ─── URL pública do app ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Stripe (modo teste) ───
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_SOLO="price_..."
STRIPE_TRIAL_DAYS=14

# ─── Web Push (gere com: npx web-push generate-vapid-keys) ───
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@barbersaas.app"

# ─── Storage S3 compatível (foto de capa) ───
# Local: npm run storage:up && npm run storage:init (RustFS do docker-compose).
# Produção: bucket com leitura pública (ex.: Cloudflare R2); chaves no Coolify.
S3_ENDPOINT="http://localhost:9300"
S3_REGION="us-east-1"
S3_BUCKET="barber-saas"
S3_ACCESS_KEY_ID="barber"
S3_SECRET_ACCESS_KEY="barber-storage"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9300/barber-saas"

# ─── Jobs (cron do Coolify chama /api/jobs/process-outbox) ───
CRON_SECRET="troque-por-um-segredo-longo"
