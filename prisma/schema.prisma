// Barber SaaS — schema multitenant (PRD v1.0, seção 8)
//
// Regras importantes:
// - Toda entidade operacional tem tenantId.
// - Relações operacionais usam chave estrangeira COMPOSTA (tenantId + id),
//   então é impossível um registro do tenant A apontar para um registro do tenant B.
// - Sobreposição de agendamentos é bloqueada no banco por uma EXCLUSION CONSTRAINT
//   (ver prisma/migrations/*_init/migration.sql), além da validação na aplicação.
// - Datas/horas sempre em UTC (timestamptz). Regras locais usam Tenant.timezone.
// - Dinheiro sempre em centavos (Int).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum TenantStatus {
  ONBOARDING // criou conta, ainda sem assinatura confirmada
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum AppointmentSource {
  PUBLIC_LINK
  OWNER_PANEL
}

enum CanceledBy {
  CUSTOMER
  OWNER
}

enum AvailabilityExceptionType {
  DAY_OFF // folga
  BLOCK // bloqueio pontual
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ──────────────────────────── Tenancy ────────────────────────────

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  slug          String       @unique
  timezone      String       @default("America/Fortaleza")
  status        TenantStatus @default(ONBOARDING)
  address       String?
  phone         String?
  /// Chave da foto de capa no storage S3 (null = sem capa).
  coverImageKey String?

  // Regras de agendamento (RN-04)
  slotIntervalMinutes       Int @default(30)
  minAdvanceMinutes         Int @default(120)
  maxAdvanceDays            Int @default(30)
  cancellationWindowMinutes Int @default(120)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  owner                  Owner?
  subscription           Subscription?
  services               Service[]
  professionals          Professional[]
  professionalServices   ProfessionalService[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  customers              Customer[]
  appointments           Appointment[]
  appointmentServices    AppointmentService[]
  pushSubscriptions      PushSubscription[]
  outboxEvents           OutboxEvent[]
}

/// Único usuário com login por tenant (premissa do MVP).
model Owner {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @unique @db.Uuid
  name         String
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]

  @@unique([tenantId, id])
}

// ──────────────────────────── Billing ────────────────────────────

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @unique @db.Uuid
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?          @db.Timestamptz(3)
  trialEndsAt          DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Idempotência dos webhooks do Stripe: cada evento é processado uma única vez.
model StripeEvent {
  id          String   @id // evt_...
  type        String
  processedAt DateTime @default(now()) @db.Timestamptz(3)
}

// ──────────────────────────── Catalog ────────────────────────────

model Service {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  name            String
  description     String?
  priceCents      Int
  durationMinutes Int
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  AppointmentService[]

  @@unique([tenantId, id])
  @@index([tenantId, active])
}

model Professional {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services          ProfessionalService[]
  availabilityRules AvailabilityRule[]
  exceptions        AvailabilityException[]
  appointments      Appointment[]

  @@unique([tenantId, id])
  @@index([tenantId, active])
}

/// Quais serviços cada barbeiro executa.
model ProfessionalService {
  tenantId       String @db.Uuid
  professionalId String @db.Uuid
  serviceId      String @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Cascade)
  service      Service      @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, professionalId, serviceId])
  @@index([tenantId, serviceId])
}

// ─────────────────────────── Scheduling ──────────────────────────

/// Janela de trabalho semanal, em minutos desde 00:00 no fuso do tenant.
/// Intervalos (almoço) = duas janelas no mesmo dia, ex.: 540–720 e 780–1140.
model AvailabilityRule {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @db.Uuid
  professionalId String @db.Uuid
  weekday        Int // 0 = domingo … 6 = sábado
  startMinute    Int
  endMinute      Int

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, professionalId, weekday])
}

/// Folga (dia inteiro) ou bloqueio parcial numa data local específica.
model AvailabilityException {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @db.Uuid
  professionalId String                    @db.Uuid
  date           DateTime                  @db.Date
  startMinute    Int? // null + endMinute null = dia inteiro
  endMinute      Int?
  type           AvailabilityExceptionType
  reason         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, professionalId, date])
}

// ────────────────────────── Appointments ─────────────────────────

model Customer {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name     String
  phone    String // E.164, ex.: +5585998765432

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  professionalId String            @db.Uuid
  customerId     String            @db.Uuid
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  status         AppointmentStatus @default(CONFIRMED)
  source         AppointmentSource @default(PUBLIC_LINK)

  // Snapshots: preservam o que foi contratado mesmo se o serviço mudar depois.
  priceSnapshotCents     Int
  serviceNameSnapshot    String
  durationSnapshotMinute Int
  customerNameSnapshot   String

  // Cancelamento público (RN-08): só o hash é guardado.
  cancelTokenHash      String?     @unique
  cancelTokenExpiresAt DateTime?   @db.Timestamptz(3)
  canceledAt           DateTime?   @db.Timestamptz(3)
  canceledBy           CanceledBy?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional         @relation(fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Restrict)
  customer     Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  services     AppointmentService[]

  @@unique([tenantId, id])
  @@index([tenantId, professionalId, startsAt])
  @@index([tenantId, startsAt])
  @@index([tenantId, customerId])
}

/// Serviços de um agendamento, na ordem escolhida pelo cliente, com o que valia na hora da marcação.
model AppointmentService {
  tenantId               String @db.Uuid
  appointmentId          String @db.Uuid
  serviceId              String @db.Uuid
  position               Int
  serviceNameSnapshot    String
  priceSnapshotCents     Int
  durationSnapshotMinute Int

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  service     Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, appointmentId, serviceId])
  @@unique([tenantId, appointmentId, position])
  @@index([tenantId, serviceId])
}

// ───────────────────────── Notifications ─────────────────────────

model PushSubscription {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  ownerId      String  @db.Uuid
  endpoint     String  @unique
  p256dh       String
  auth         String
  userAgent    String?
  enabled      Boolean @default(true)
  failureCount Int     @default(0)

  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSuccessAt DateTime? @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  Owner  @relation(fields: [tenantId, ownerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, enabled])
}

/// Outbox transacional: eventos gravados na mesma transação do agendamento
/// e processados por /api/jobs/process-outbox (cron). Sem Redis no MVP.
model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String?      @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @db.Timestamptz(3)
  lastError   String?

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
}

// ─────────────────────────── Segurança ───────────────────────────

/// Rate limiting das rotas públicas (RN-10) sem Redis: janela fixa por chave.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz(3)
}
